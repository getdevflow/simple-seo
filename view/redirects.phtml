    <div class="modal fade" id="bulkRedirectModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="<?=esc_attr(esc_html__('Close', $domain));?>">
                        <span aria-hidden="true">&times;</span>
                    </button>

                    <h4 class="modal-title" id="bulkRedirectModalTitle">
                        <?=esc_html__('Bulk Action', $domain);?>
                    </h4>
                </div>

                <div class="modal-body">
                    <p id="bulkRedirectModalMessage"></p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal"><?=esc_html__('Cancel', $domain);?></button>
                    <button type="button" id="bulkRedirectModalConfirm" class="btn btn-primary"><?=esc_html__('Continue', $domain);?></button>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function ($) {
            'use strict';

            $(document)
                .off('change.simpleSeoRedirects', '#seo-redirect-select-all')
                .on('change.simpleSeoRedirects', '#seo-redirect-select-all', function () {
                    $('.seo-redirect-checkbox').prop('checked', this.checked);
                });

            $(document)
                .off('change.simpleSeoRedirects', '.seo-redirect-checkbox')
                .on('change.simpleSeoRedirects', '.seo-redirect-checkbox', function () {
                    var total = $('.seo-redirect-checkbox').length;
                    var checked = $('.seo-redirect-checkbox:checked').length;

                    $('#seo-redirect-select-all').prop(
                        'checked',
                        total > 0 && total === checked
                    );
                });

            $(document)
                .off('click.simpleSeoRedirects', '#seo-redirect-bulk-apply')
                .on('click.simpleSeoRedirects', '#seo-redirect-bulk-apply', function () {
                    var action = String($('#seo-redirect-bulk-selector').val() || '');
                    var $confirm = $('#bulkRedirectModalConfirm');

                    if (action === '') {
                        $('#bulkRedirectModalTitle').text('Bulk Action Required');
                        $('#bulkRedirectModalMessage').text('Please select a bulk action before continuing.');
                        $confirm.hide();
                        $('#bulkRedirectModal').modal('show');

                        return;
                    }

                    var ids = [];

                    $('.seo-redirect-checkbox:checked').each(function () {
                        var id = String($(this).val() || '');

                        if (id !== '') {
                            ids.push(id);
                        }
                    });

                    if (ids.length === 0) {
                        $('#bulkRedirectModalTitle').text('No Redirects Selected');
                        $('#bulkRedirectModalMessage').text('Please select at least one redirect.');
                        $confirm.hide();
                        $('#bulkRedirectModal').modal('show');

                        return;
                    }

                    $('#seo-redirect-bulk-action').val(action);
                    $('#seo-redirect-bulk-ids').val(ids.join(','));

                    var actionLabel = action.charAt(0).toUpperCase() + action.slice(1);

                    $('#bulkRedirectModalTitle').text(actionLabel + ' Redirects');

                    $('#bulkRedirectModalMessage').text(
                        'Apply "' + actionLabel + '" to '
                        + ids.length
                        + ' selected redirect'
                        + (ids.length === 1 ? '?' : 's?')
                    );

                    $confirm
                        .show()
                        .removeClass('btn-danger btn-warning btn-success btn-primary');

                    switch (action) {
                        case 'delete':
                            $confirm.addClass('btn-danger');
                            break;

                        case 'disable':
                            $confirm.addClass('btn-warning');
                            break;

                        case 'enable':
                            $confirm.addClass('btn-success');
                            break;

                        default:
                            $confirm.addClass('btn-primary');
                    }

                    $('#bulkRedirectModal').modal('show');
                });

            $(document)
                .off('click.simpleSeoRedirects', '#bulkRedirectModalConfirm')
                .on('click.simpleSeoRedirects', '#bulkRedirectModalConfirm', function () {
                    $('#bulkRedirectModal').modal('hide');
                    $('#seo-redirect-bulk-form').trigger('submit');
                });

            $('#bulkRedirectModal').on('hidden.bs.modal', function () {
                $('#bulkRedirectModalConfirm')
                    .show()
                    .removeClass('btn-danger btn-warning btn-success')
                    .addClass('btn-primary');
            });
        })(jQuery);
    </script>

    <?php
});
