<script>
    (function ($) {
        function updateSeoPreview() {
            var title = $('.js-seo-meta-title').val() || '<?=esc_html__('Untitled', 'simple-seo');?>';
            var description = $('.js-seo-meta-description').val() || '<?=esc_html__('No meta description has been set.', 'simple-seo');?>'

            $('.js-seo-preview-title').text(title);
            $('.js-seo-preview-description').text(description);
        }

        $(document).on('input keyup change', '.js-seo-meta-title, .js-seo-meta-description', updateSeoPreview);

        $(updateSeoPreview);
    })(jQuery);
</script>
